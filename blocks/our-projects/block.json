{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uuwg/our-projects",
  "title": "UUWG Our Projects",
  "category": "uuwg-blocks",
  "icon": "format-image",
  "style": "file:./style.css",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",
  "viewScript": "file:./view.js",
  "attributes": {
    "heading": { "type": "string", "default": "Our projects" },
    "buttonText": { "type": "string", "default": "View all projects" },
    "buttonUrl": { "type": "string", "default": "/projects" },
    "smallButtonText": { "type": "string", "default": "Read more" },
    "countOfProjects": {
      "type": "number",
      "default": 3
    },
    "showPagination": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false
  }
}
