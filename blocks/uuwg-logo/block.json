{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uuwg/uuwg-logo",
  "title": "UUWG Site Logo",
  "category": "uuwg-blocks",
  "icon": "format-image",
  "style": "file:./style.css",
  "editorScript": "file:./index.js",
  "render": "file:./render.php",

  "attributes": {
    "darkLogo": {
      "type": "object",
      "default": {
        "url": "http://uuwg.local/wp-content/uploads/2026/08/Logo.svg"
      }
    },
    "lightLogo": {
      "type": "object",
      "default": {
        "url": "http://uuwg.local/wp-content/uploads/2026/08/Logo-white.svg"
      }
    }
  },

  "supports": {
    "html": false,
    "anchor": true
  }
}
