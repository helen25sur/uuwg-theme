{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uuwg/socials-share",
  "title": "UUWG Social Share Buttons",
  "category": "uuwg-blocks",
  "icon": "share",
  "description": "Кнопки 'Поділитися' для публікацій",
  "textdomain": "uuwg",
  "attributes": {
    "instagramLabel": { "type": "string", "default": "Instagram" },
    "facebookLabel": { "type": "string", "default": "Facebook" },
    "youtubeLabel": { "type": "string", "default": "Youtube" },
    "linkedinLabel": { "type": "string", "default": "Linkedin" },
    "telegramLabel": { "type": "string", "default": "Telegram" },
    "copyLabel": { "type": "string", "default": "Copy Link" }
  },
  "editorScript": "file:./index.js",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css"
}
