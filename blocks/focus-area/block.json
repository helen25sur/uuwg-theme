{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uuwg/focus-area",
  "title": "UUWG: Focus Areas",
  "category": "uuwg-blocks",
  "attributes": {
    "heading": { "type": "string", "default": "Focus areas" },
    "buttonText": { "type": "string", "default": "Get Help" },
    "buttonUrl": { "type": "string", "default": "#contact-us" },
    "item1Title": { "type": "string", "default": "Migration & Integration" },
    "item1Text": {
      "type": "string",
      "default": "Legal guidance, education, and community support that help women navigate life in Greece."
    },
    "item2Title": { "type": "string", "default": "Gender Violence Prevention" },
    "item2Text": {
      "type": "string",
      "default": "Psychological support, safe spaces, and advocacy for women facing violence, exploitation, or discrimination."
    },
    "item3Title": { "type": "string", "default": "Economic Justice" },
    "item3Text": {
      "type": "string",
      "default": "Language courses, professional training, employment support, and entrepreneurship programs."
    },
    "item4Title": { "type": "string", "default": "Culture & Community" },
    "item4Text": {
      "type": "string",
      "default": "Preserving Ukrainian heritage while fostering cross-cultural connection and belonging."
    },
    "showPagination": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "editorStyle": "file:./editor.css",
  "render": "file:./render.php"
}
