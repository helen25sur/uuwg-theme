{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uuwg/impact-glance",
  "title": "UUWG: Impact at a glance",
  "category": "uuwg-blocks",
  "attributes": {
    "heading": { "type": "string", "default": "Impact at a glance" },
    "headerText": {
      "type": "string",
      "default": "Behind every project are real people. Through personal stories and testimonials, we share how our work impacts lives and communities."
    },
    "buttonText": { "type": "string", "default": "Join us" },
    "buttonUrl": { "type": "string", "default": "#contact-us" }
  },
  "supports": {
    "html": false,
    "align": ["wide", "full"],
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
