{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "uuwg/hero-about-us",
  "title": "UUWG: Hero About Us",
  "category": "uuwg-blocks",
  "icon": "cover-image",
  "description": "Головний банер сторінки Про нас: заголовок, підзаголовок, дві кнопки, фотокартки.",
  "textdomain": "uuwg",
  "attributes": {
    "title": {
      "type": "string",
      "default": "Union of Ukrainian Women in Greece"
    },
    "subtitle": {
      "type": "string",
      "default": "A women-led community organization in Athens that supports Ukrainian and other women impacted by war and migration"
    },
    "yellowButtonText": {
      "type": "string",
      "default": "Donate"
    },
    "yellowButtonUrl": {
      "type": "string",
      "default": ""
    },
    "secondaryButtonText": {
      "type": "string",
      "default": "Get Help"
    },
    "secondaryButtonUrl": {
      "type": "string",
      "default": "#contact-us"
    },
    "photo1Id": { "type": "number", "default": 0 },
    "photo1Url": {
      "type": "string",
      "default": "http://uuwg.local/wp-content/themes/uuwg-theme/assets/images/about-us/about-us-01.png"
    },
    "photo2Id": { "type": "number", "default": 0 },
    "photo2Url": {
      "type": "string",
      "default": "http://uuwg.local/wp-content/themes/uuwg-theme/assets/images/about-us/about-us-02.png"
    },
    "photo3Id": { "type": "number", "default": 0 },
    "photo3Url": {
      "type": "string",
      "default": "http://uuwg.local/wp-content/themes/uuwg-theme/assets/images/about-us/about-us-03.png"
    },
    "photo4Id": { "type": "number", "default": 0 },
    "photo4Url": {
      "type": "string",
      "default": "http://uuwg.local/wp-content/themes/uuwg-theme/assets/images/about-us/about-us-04.png"
    },
    "photo5Id": { "type": "number", "default": 0 },
    "photo5Url": {
      "type": "string",
      "default": "http://uuwg.local/wp-content/themes/uuwg-theme/assets/images/about-us/about-us-05.png"
    },
    "photo6Id": { "type": "number", "default": 0 },
    "photo6Url": {
      "type": "string",
      "default": "http://uuwg.local/wp-content/themes/uuwg-theme/assets/images/about-us/about-us-06.jpg"
    }
  },
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"],
    "color": {
      "background": true
    },
    "spacing": {
      "padding": true
    }
  },
  "editorScript": "file:./index.js",
  "style": "file:./style.css",
  "render": "file:./render.php"
}
