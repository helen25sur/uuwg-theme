{
  "$schema": "https://schemas.wp.org/wp/7.0/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": true,
    "layout": {
      "contentSize": "1280px",
      "wideSize": "1440px"
    },
    "color": {
      "palette": [
        {
          "slug": "white",
          "color": "#FFFFFF",
          "name": "White (primary)"
        },
        {
          "slug": "background",
          "color": "#F8F6EE",
          "name": "Warm Beige"
        },
        {
          "slug": "primary",
          "color": "#0057B8",
          "name": "Primary Blue"
        },
        {
          "slug": "secondary",
          "color": "#FFD700",
          "name": "Accent Yellow"
        },
        {
          "slug": "dark-blue",
          "color": "#033B78",
          "name": "Dark Blue"
        },
        {
          "slug": "blue-500",
          "color": "#014795",
          "name": "Blue 500"
        },
        {
          "slug": "blue-300",
          "color": "#035BBE",
          "name": "Blue 300"
        },
        {
          "slug": "blue-200",
          "color": "#5077B7",
          "name": "Blue 200"
        },
        {
          "slug": "blue-100",
          "color": "#C2D0D9",
          "name": "Blue 100"
        },
        {
          "slug": "light-blue",
          "color": "#D8E1E7",
          "name": "Light Blue"
        },
        {
          "slug": "yellow-200",
          "color": "#E8A800",
          "name": "Yellow 200"
        },
        {
          "slug": "yellow-100",
          "color": "#F5C200",
          "name": "Yellow 100"
        },
        {
          "slug": "grey",
          "color": "#8A8A8A",
          "name": "Grey"
        },
        {
          "slug": "light-grey",
          "color": "#C6C6C6",
          "name": "Light Grey"
        }
      ],
      "custom": true,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "heading",
          "fontFamily": "Manrope, sans-serif",
          "name": "Heading"
        },
        {
          "slug": "body",
          "fontFamily": "Manrope, sans-serif",
          "name": "Body"
        }
      ],
      "fontSizes": [
        { "slug": "small-xs", "size": "14px", "name": "Extra Small Text" },
        { "slug": "text-sm", "size": "16px", "name": "Text Small" },
        { "slug": "text-medium", "size": "18px", "name": "Text Medium" },
        { "slug": "text-body", "size": "20px", "name": "Body Text" },
        { "slug": "body-lg", "size": "22px", "name": "Body Large" },
        { "slug": "heading-sm", "size": "24px", "name": "Heading Small" },
        { "slug": "heading-md", "size": "28px", "name": "Heading Medium" },
        { "slug": "heading-lg", "size": "32px", "name": "Heading Large" },
        { "slug": "heading-xl", "size": "46px", "name": "Heading XL" },
        { "slug": "hero", "size": "77px", "name": "Hero" }
      ],
      "customFontSize": false,
      "lineHeight": true
    },
    "spacing": {
      "spacingScale": {
        "steps": 7
      },
      "units": ["px", "%", "rem", "vh", "vw"],
      "padding": true,
      "margin": true,
      "blockGap": true
    },
    "border": {
      "radius": true,
      "color": true,
      "width": true
    },
    "custom": {
      "borderRadius": {
        "hero": "16px",
        "card": "16px",
        "button": "999px"
      },
      "spacing": {
        "containerGutter": "80px",
        "blockGap": "140px"
      },
      "pill": {
        "paddingY": "8px",
        "paddingX": "16px"
      },
      "button": {
        "paddingY": "16px",
        "paddingX": "32px"
      }
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--background)",
      "text": "var(--wp--preset--color--primary)"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--body)",
      "fontSize": "var(--wp--preset--font-size--text-body)",
      "lineHeight": "1.2"
    },
    "elements": {
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--heading)",
          "fontWeight": "700"
        },
        "spacing": {
          "margin": {
            "top": "0",
            "bottom": "0",
            "right": "0",
            "left": "0"
          }
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--secondary)",
          "text": "var(--wp--preset--color--primary)"
        },
        "border": { "radius": "var(--wp--custom--border-radius--button)" },
        "typography": {
          "fontSize": "var(--wp--preset--font-size--body-lg)",
          "fontWeight": "600"
        },
        "spacing": {
          "padding": {
            "top": "var(--wp--custom--button--padding-y)",
            "bottom": "var(--wp--custom--button--padding-y)",
            "left": "var(--wp--custom--button--padding-x)",
            "right": "var(--wp--custom--button--padding-x)"
          }
        }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--primary)"
        },
        "typography": {
          "textDecoration": "none"
        }
      }
    }
  },
  "templateParts": [
    {
      "name": "header",
      "title": "Header",
      "area": "header"
    },
    {
      "name": "footer",
      "title": "Footer",
      "area": "footer"
    },
    {
      "name": "contact-section",
      "title": "Contact Section",
      "area": "uncategorized"
    }
  ],
  "customTemplates": [
    {
      "name": "projects",
      "title": "Projects",
      "postTypes": ["page"]
    }
  ]
}
